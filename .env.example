# Copie para .env e ajuste. O .env real não vai para o git.

DATABASE_URL="postgresql://heliogoiano:heliogoiano_dev@localhost:5433/heliogoiano?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Fase 4 (admin) ---
# Assina o cookie de sessão. Mínimo 32 caracteres — o app recusa iniciar com menos.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Crie o usuário do admin com:
#   npm run admin:criar -- email@exemplo.com "Senha Forte" "Nome"

# --- Storage das fotos (Supabase Storage) ---
#
# Setup, uma vez só:
#   1. Crie um projeto em supabase.com
#   2. Storage > New bucket > nome "imoveis", marque "Public bucket"
#      (público de propósito: são fotos de anúncio, que precisam aparecer no Google
#       e no preview do WhatsApp — URL assinada só criaria link que expira)
#   3. Project Settings > API: copie a URL e a chave service_role
#
# A service_role ignora as regras de segurança do banco. NUNCA use ela no navegador
# nem com o prefixo NEXT_PUBLIC_ — só o servidor lê estas duas variáveis.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

